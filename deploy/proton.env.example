# Production environment for prtn.xyz. Copy to /srv/proton/.env, fill in, then:
#   chown proton:proton /srv/proton/.env && chmod 600 /srv/proton/.env
#
# PORT and HOST are deliberately absent: three services listen, they cannot share one PORT, so
# deploy/ecosystem.config.cjs sets both per process. A real environment variable wins over an
# --env-file entry, so anything you add here for PORT would be ignored anyway.

# ─── Discord application ────────────────────────────────────────────────────
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Redirect URI to register in the Discord developer portal (OAuth2 → Redirects):
#   https://prtn.xyz/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Global registration: commands propagate to every guild and take up to an hour to appear.
# DISCORD_TEST_GUILD_ID is the development safety rail and is intentionally unset here.
COMMAND_REGISTRATION_SCOPE=global

# ─── Postgres ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://proton:CHANGE_ME@127.0.0.1:5432/proton

# ─── Redis ──────────────────────────────────────────────────────────────────
# Add the password as redis://:PASSWORD@127.0.0.1:6379 if requirepass is set.
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB_BUS=0
REDIS_DB_DEDUPE=1
REDIS_DB_SESSIONS=2
REDIS_DB_JOBS=3
REDIS_DB_MODULES=4
REDIS_DB_STATE=5
REDIS_DB_USERS=6
REDIS_DB_MESSAGES=7

# Application emoji ids for the Server Logs tree. Leave unset to fall back to ├ and └.
PROTON_EMOJI_STEM=
PROTON_EMOJI_REPLY=

CONFIG_CACHE_TTL_MS=5000

# ─── Service URLs ───────────────────────────────────────────────────────────
# Loopback: both processes bind 127.0.0.1 and nginx never proxies them.
REST_PROXY_URL=http://127.0.0.1:9001
API_URL=http://127.0.0.1:9002

# ─── Dashboard / auth ───────────────────────────────────────────────────────
DASHBOARD_URL=https://prtn.xyz
BETTER_AUTH_URL=https://prtn.xyz

# Generate each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
API_SHARED_SECRET=
VERIFY_LINK_SECRET=

# ─── Jobs ───────────────────────────────────────────────────────────────────
REVERSAL_SWEEP_INTERVAL_MS=15000

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
