{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Proton base",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Bun executes TypeScript directly, so workspace packages export .ts source
    // and are imported with explicit .ts extensions. Safe alongside noEmit.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true

    // PLAN.md deviation D3: no `baseUrl` / `paths`. TypeScript 7 deprecates baseUrl,
    // so cross-package imports go through Bun workspaces + package `exports` instead.
  }
}
