# Copy to .env and fill in. .env is gitignored and never committed (PLAN.md I10).
# The real bot token must not appear in code, fixtures, tests or logs.

# ─── Discord application ────────────────────────────────────────────────────
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# OAuth credentials for the dashboard (Better Auth Discord provider).
# Register this redirect URI in the Discord developer portal:
#   http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SAFETY RAIL: the only guild the bot may be invited to or act on in development.
# See CLAUDE.md — never invite the bot to, or act on, any other guild.
DISCORD_TEST_GUILD_ID=

# guild = instant propagation for development; global = production (PLAN.md §2)
COMMAND_REGISTRATION_SCOPE=guild

# ─── Postgres ───────────────────────────────────────────────────────────────
# Non-default host port: 5432 is already taken on this machine by another
# project's container. Change PROTON_POSTGRES_PORT (read by docker-compose.yml)
# and this URL together if you need a different one.
PROTON_POSTGRES_PORT=5433
DATABASE_URL=postgres://proton:proton@localhost:5433/proton

# ─── Redis ──────────────────────────────────────────────────────────────────
# One container in dev, separate logical DBs (PLAN.md §2).
# Non-default host port: 6379 is a native redis-server service, 6380 another project.
PROTON_REDIS_PORT=6381
REDIS_URL=redis://localhost:6381
REDIS_DB_BUS=0        # event-bus streams
REDIS_DB_DEDUPE=1     # idempotency keys (I4)
REDIS_DB_SESSIONS=2   # gateway shard session state (I13)
REDIS_DB_JOBS=3       # BullMQ: drives the temp-action reversal sweep
REDIS_DB_MODULES=4    # module-owned data: rate windows, anti-nuke maintenance flag,
                      # phishing blocklist, quarantine records, backup guild layouts
REDIS_DB_STATE=5      # guild role/channel snapshots for prechecks (I8)
REDIS_DB_USERS=6      # username/avatar cache for server-log embed footers
REDIS_DB_MESSAGES=7   # opt-in short-lived message text, so edit logs can show what changed.
                      # The one dataset where allkeys-lru eviction is acceptable.

# Server Logs draws each embed as a tree: STEM is the `replycontinued` branch beside every
# line but the last, REPLY is the `reply` corner beside the last. Both must be APPLICATION
# emoji — uploaded under the app's Emojis tab — because a guild emoji id renders as broken
# text in every other server Proton is in. The worker verifies that at boot and falls back to
# the plain characters ├ and └ for any id the application does not own. Leave unset to use
# the fallbacks.
PROTON_EMOJI_STEM=1539999327580192858
PROTON_EMOJI_REPLY=1539999328674783242

# How long the worker may reuse a module's config before re-reading it. A
# listener reads config once per event, so this is what stops phishing turning
# every Discord message into an API round trip. Cost is staleness: a dashboard
# toggle takes up to this long to reach the worker.
CONFIG_CACHE_TTL_MS=5000

# ─── Service URLs ───────────────────────────────────────────────────────────
# Every Discord REST call in every process egresses through the proxy (I2).
REST_PROXY_URL=http://localhost:3001
API_URL=http://localhost:3002

# ─── Dashboard / auth ───────────────────────────────────────────────────────
DASHBOARD_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ─── Jobs ───────────────────────────────────────────────────────────────────
# How often the worker looks for temporary actions that are due to be reversed.
# This is the worst-case lateness of an automatic unban.
REVERSAL_SWEEP_INTERVAL_MS=15000

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
